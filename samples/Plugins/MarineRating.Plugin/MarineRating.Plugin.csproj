    </ProjectReference>
    <ProjectReference Include="..\..\QuoteHost.Contracts\QuoteHost.Contracts.csproj">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </ProjectReference>
  </ItemGroup>
