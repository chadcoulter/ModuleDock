<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>PrivateFrameworkPlugin</AssemblyName>
    <RootNamespace>PrivateFrameworkPlugin</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <None Include="plugin.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- Deliberately a Microsoft.Extensions.* package the test host does not reference,
         so it can only resolve from the plugin's own directory. -->
    <PackageReference Include="Microsoft.Extensions.ObjectPool" />
    <ProjectReference Include="..\..\..\src\ModuleDock.Abstractions\ModuleDock.Abstractions.csproj">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </ProjectReference>
    <ProjectReference Include="..\ModuleDock.TestContracts\ModuleDock.TestContracts.csproj">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </ProjectReference>
  </ItemGroup>
</Project>
