<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <IsPackable>false</IsPackable>
    <NeutralLanguage>en-GB</NeutralLanguage>
  </PropertyGroup>

  <!-- Shared NuGet package metadata. Individual package projects opt in with IsPackable. -->
  <PropertyGroup>
    <VersionPrefix>1.0.0</VersionPrefix>
    <Authors>Patrick Kearns</Authors>
    <Company>Patrick Kearns</Company>
    <Copyright>Copyright (c) 2026 Patrick Kearns</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/kearns2000/ModuleDock</PackageProjectUrl>
    <RepositoryUrl>https://github.com/kearns2000/ModuleDock</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReleaseNotes>First public release of ModuleDock: manifest-driven startup plugin hosting, validation and dependency isolation for .NET 10 Generic Host applications.</PackageReleaseNotes>
    <!-- SourceLink is provided implicitly by the .NET SDK for GitHub repositories. -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

</Project>
