<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>ModuleDock</PackageId>
    <Title>ModuleDock</Title>
    <Description>Manifest-driven plugin hosting, validation and dependency isolation for .NET 10 Generic Host applications. Discovers per-plugin directories, validates plugin.json, loads each plugin into its own AssemblyLoadContext, and registers services before the host is built.</Description>
    <PackageTags>plugin;plugins;plugin-host;plugin-system;plugin-loader;plugin-framework;plugin-architecture;module;modules;modular;modularity;extensibility;extensible;addin;add-in;assemblyloadcontext;assembly-loading;dynamic-loading;dependency-isolation;dependency-injection;ioc;generic-host;hosting;aspnetcore;dotnet;dotnet-10;net10;csharp</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <EnablePackageValidation>true</EnablePackageValidation>
    <RootNamespace>ModuleDock</RootNamespace>
    <AssemblyName>ModuleDock</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="\" />
    <None Include="../../icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../ModuleDock.Abstractions/ModuleDock.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ModuleDock.Tests" />
    <InternalsVisibleTo Include="ModuleDock.IntegrationTests" />
  </ItemGroup>

</Project>
