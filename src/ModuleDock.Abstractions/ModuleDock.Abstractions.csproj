<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>ModuleDock.Abstractions</PackageId>
    <Title>ModuleDock.Abstractions</Title>
    <Description>Contracts for ModuleDock plugins. Plugin authors reference this package plus the host application's contract assembly; the host uses the ModuleDock package to discover, validate and load plugins.</Description>
    <PackageTags>plugin;plugins;plugin-contracts;plugin-sdk;plugin-api;plugin-architecture;abstractions;contracts;module;modules;modular;modularity;extensibility;extensible;addin;add-in;assemblyloadcontext;dependency-injection;ioc;generic-host;hosting;dotnet;dotnet-10;net10;csharp</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <EnablePackageValidation>true</EnablePackageValidation>
    <RootNamespace>ModuleDock</RootNamespace>
    <AssemblyName>ModuleDock.Abstractions</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="\" />
    <None Include="../../icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

</Project>
